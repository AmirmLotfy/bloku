{
  "name": "bloku-extension",
  "version": "2.0.0",
  "private": true,
  "license": "GPL-3.0-only",
  "scripts": {
    "validate:dnr": "node scripts/v2-validate-dnr.mjs",
    "validate:package": "node scripts/v2-release-artifacts.mjs --check-only --extension-only",
    "package:extension": "npm run build:v2 && node scripts/v2-release-artifacts.mjs",
    "test:foundation": "tsx --test src/*.test.ts",
    "test:engine": "tsx --test engine/*.test.ts",
    "build:engine": "node scripts/v2-build-engine.mjs",
    "test:engine:browser": "node scripts/v2-build-engine.mjs --gate && node scripts/v2-engine-gate.mjs",
    "build:v2": "node scripts/v2-build-extension.mjs",
    "test:runtime": "node scripts/v2-runtime-check.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@adguard/agtree": "4.3.0",
    "@adguard/dnr-converter": "2.0.0",
    "@adguard/logger": "2.0.1",
    "@adguard/tsurlfilter": "6.0.4",
    "@adguard/tswebextension": "6.0.1",
    "@duckduckgo/autoconsent": "17.2.0",
    "terser": "5.46.0"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "puppeteer-core": "25.16.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "overrides": {
    "js-yaml": "3.15.2"
  }
}
