{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "version": "2.0.0",
  "minimum_chrome_version": "145",
  "homepage_url": "https://bloku.app",
  "permissions": ["declarativeNetRequest", "activeTab", "scripting", "storage", "unlimitedStorage", "webRequest", "webNavigation", "alarms", "idle", "contextMenus"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}},
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"},
  "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["engine/content-script.js", "content.js"], "run_at": "document_start", "all_frames": true}],
  "declarative_net_request": {"rule_resources": []},
  "web_accessible_resources": [{"resources": ["engine/war/redirects/*", "engine/assistant.js", "locales/*.json", "consent.js"], "matches": ["http://*/*", "https://*/*"]}],
  "commands": {
    "_execute_action": {"suggested_key": {"default": "Ctrl+Shift+B", "mac": "Command+Shift+B"}, "description": "Open BLOKU"},
    "toggle-protection": {"suggested_key": {"default": "Alt+Shift+B"}, "description": "Toggle ad protection"}
  },
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}
}
