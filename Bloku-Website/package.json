{
  "name": "bloku-website",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build && node scripts/serve.mjs",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir .ssr && node scripts/prerender.mjs",
    "preview": "node scripts/serve.mjs",
    "assets:branding": "node scripts/optimize-branding.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src vite.config.ts",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "lucide-react": "0.462.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@types/node": "22.16.5",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react-swc": "4.3.3",
    "eslint": "9.32.0",
    "globals": "15.15.0",
    "jsdom": "26.1.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
