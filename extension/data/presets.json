          ".featured-content-carousel"
        ]
      }
    ]
  },
  "tiktok.com": {
    "label": "TikTok",
    "groups": [
      {
        "id": "foryou",
        "label": "For You feed",
        "selectors": [
          "div[data-e2e=\"recommend-list-item-container\"]"
        ]
      }
    ]
  }
