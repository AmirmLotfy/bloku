{
  "name": "bloku-extension",
  "version": "2.0.0",
  "private": true,
  "license": "GPL-3.0-only",
  "scripts": {
    "build": "node scripts/v2-build-extension.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts engine/*.test.ts",
    "test:browser": "node scripts/v2-build-engine.mjs --gate && node scripts/v2-engine-gate.mjs",
    "validate:locales": "node scripts/validate-locales.mjs",
    "validate:dnr": "node scripts/v2-validate-dnr.mjs",
    "validate:package": "node scripts/v2-release-artifacts.mjs --check-only --extension-only",
    "check": "npm run typecheck && npm test && npm run validate:locales && npm run validate:dnr && npm run validate:package",
    "package": "npm run build && node scripts/v2-release-artifacts.mjs",
    "filters:update": "node scripts/v2-update-filters.mjs",
    "audit:dependencies": "node scripts/v2-dependency-audit.mjs",
    "build:v2": "npm run build",
    "test:foundation": "tsx --test src/*.test.ts",
    "test:engine": "tsx --test engine/*.test.ts",
    "test:engine:browser": "npm run test:browser"
  },
  "dependencies": {
    "@adguard/agtree": "4.3.0",
    "@adguard/dnr-converter": "2.0.0",
    "@adguard/logger": "2.0.1",
    "@adguard/tsurlfilter": "6.0.4",
    "@adguard/tswebextension": "6.0.1",
    "@duckduckgo/autoconsent": "17.2.0",
    "terser": "5.46.0"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "puppeteer-core": "25.16.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "overrides": {
    "js-yaml": "3.15.2"
  }
}
